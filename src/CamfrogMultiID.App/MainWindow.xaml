<Window x:Class="CamfrogMultiID.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camfrog Multi-ID Manager"
        Width="1180"
        Height="720"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <WrapPanel>
            <Button Content="+ Add Account" Click="Add_Click"/>
            <Button Content="Settings" Click="Settings_Click"/>
            <Button Content="Start Selected" Click="StartSelected_Click"/>
            <Button Content="Stop Selected" Click="StopSelected_Click"/>
            <Button Content="Remove Selected" Click="RemoveSelected_Click"/>
            <Button Content="Start All" Click="StartAll_Click"/>
            <Button Content="Stop All" Click="StopAll_Click"/>
            <Button Content="Refresh" Click="Refresh_Click"/>
        </WrapPanel>

        <DataGrid x:Name="AccountsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="0,10"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/>
                <DataGridTextColumn Header="Account" Binding="{Binding DisplayName}" Width="170"/>
                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="170"/>
                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="70"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70"/>
                <DataGridTextColumn Header="Started (UTC)" Binding="{Binding StartedAtUtc}" Width="190"/>
                <DataGridTextColumn Header="Error" Binding="{Binding LastError}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox Grid.Row="2" Header="Application Log">
            <TextBox x:Name="LogBox"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Padding="6"/>
        </GroupBox>
    </Grid>
</Window>

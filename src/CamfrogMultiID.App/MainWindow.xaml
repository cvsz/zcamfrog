<Window x:Class="CamfrogMultiID.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:CamfrogMultiID.App" Title="{x:Static loc:Strings.MainTitle}" Width="1240" Height="940" MinWidth="980" MinHeight="700" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="14">
        <WrapPanel DockPanel.Dock="Top">
            <Button Content="{x:Static loc:Strings.AddAccount}" Click="Add_Click"/>
            <Button Content="{x:Static loc:Strings.Edit}" Click="Edit_Click"/>
            <Button Content="{x:Static loc:Strings.Delete}" Click="Delete_Click"/>
            <Button Content="{x:Static loc:Strings.EnableDisable}" Click="ToggleEnabled_Click"/>
            <Button Content="{x:Static loc:Strings.Settings}" Click="Settings_Click"/>
            <Button Content="{x:Static loc:Strings.StartSelected}" Click="StartSelected_Click"/>
            <Button Content="{x:Static loc:Strings.StopSelected}" Click="StopSelected_Click"/>
            <Button Content="{x:Static loc:Strings.StartAll}" Click="StartAll_Click"/>
            <Button Content="{x:Static loc:Strings.StopAll}" Click="StopAll_Click"/>
            <Button Content="{x:Static loc:Strings.Refresh}" Click="Refresh_Click"/>
            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{x:Static loc:Strings.Search}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="SearchBox" Width="200" Height="26" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/>
            </StackPanel>
        </WrapPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock x:Name="StatusCounts" Text="—"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="StatusClient" Text="—"/></StatusBarItem>
        </StatusBar>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto" MaxHeight="170"/><RowDefinition Height="180"/></Grid.RowDefinitions>
            <DataGrid x:Name="AccountsGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Margin="0,10" CanUserAddRows="False" SelectionChanged="AccountsGrid_SelectionChanged" MouseDoubleClick="AccountsGrid_DoubleClick" KeyDown="AccountsGrid_KeyDown">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{x:Static loc:Strings.CtxStart}" Click="StartSelected_Click"/>
                        <MenuItem Header="{x:Static loc:Strings.CtxStop}" Click="StopSelected_Click"/>
                        <Separator/>
                        <MenuItem Header="{x:Static loc:Strings.Edit}" Click="Edit_Click"/>
                        <MenuItem Header="{x:Static loc:Strings.EnableDisable}" Click="ToggleEnabled_Click"/>
                        <MenuItem Header="{x:Static loc:Strings.CtxChangePassword}" Click="ChangePassword_Click"/>
                        <MenuItem Header="{x:Static loc:Strings.CtxClearError}" Click="ClearError_Click"/>
                        <Separator/>
                        <MenuItem Header="{x:Static loc:Strings.Delete}" Click="Delete_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static loc:Strings.ColId}" Binding="{Binding Id}" Width="55"/>
                    <DataGridTextColumn Header="{x:Static loc:Strings.ColAccount}" Binding="{Binding DisplayName}" Width="170"/>
                    <DataGridTextColumn Header="{x:Static loc:Strings.ColUsername}" Binding="{Binding Username}" Width="150"/>
                    <DataGridCheckBoxColumn Header="{x:Static loc:Strings.ColEnabled}" Binding="{Binding Enabled}" Width="70"/>
                    <DataGridTextColumn Header="{x:Static loc:Strings.ColStatus}" Binding="{Binding Status}" Width="90"/>
                    <DataGridTextColumn Header="{x:Static loc:Strings.ColPid}" Binding="{Binding ProcessId}" Width="70"/>
                    <DataGridTextColumn Header="{x:Static loc:Strings.ColStarted}" Binding="{Binding StartedAtUtc}" Width="170"/>
                    <DataGridTextColumn Header="{x:Static loc:Strings.ColError}" Binding="{Binding LastError}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <GroupBox Grid.Row="1" Header="{x:Static loc:Strings.SelectedAccount}" Margin="0,0,0,8">
                <TextBlock x:Name="DetailsBox" TextWrapping="Wrap" Padding="6" FontFamily="Consolas, Leelawadee UI, Segoe UI" FontSize="12" Text="{x:Static loc:Strings.DetailsSelectPrompt}"/>
            </GroupBox>
            <GroupBox Grid.Row="2" Header="{x:Static loc:Strings.DashboardTitle}" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="DashboardStats" TextWrapping="Wrap" Padding="6" FontFamily="Consolas, Leelawadee UI, Segoe UI" FontSize="12" VerticalAlignment="Top"/>
                    <ListBox x:Name="EventsList" Grid.Column="1" Margin="6,0,0,0" MaxHeight="140" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Leelawadee UI, Segoe UI" FontSize="11"/>
                </Grid>
            </GroupBox>
            <GroupBox Grid.Row="3" Header="{x:Static loc:Strings.ApplicationLog}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{x:Static loc:Strings.Level}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="LogLevelBox" Width="110" SelectionChanged="LogLevelBox_SelectionChanged">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                            <ComboBoxItem Content="INFO"/>
                            <ComboBoxItem Content="WARN"/>
                            <ComboBoxItem Content="ERROR"/>
                        </ComboBox>
                        <CheckBox x:Name="AutoScrollBox" Content="{x:Static loc:Strings.AutoScroll}" IsChecked="True" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <Button Content="{x:Static loc:Strings.ClearLogView}" Click="ClearLogView_Click" Margin="12,0,0,0"/>
                        <Button Content="{x:Static loc:Strings.ExportLog}" Click="ExportLog_Click" Margin="4,0,0,0"/>
                        <Button Content="{x:Static loc:Strings.Diagnostics}" Click="Diagnostics_Click" Margin="4,0,0,0"/>
                        <Button Content="{x:Static loc:Strings.OpenLogFolder}" Click="OpenLogFolder_Click" Margin="4,0,0,0"/>
                    </StackPanel>
                    <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="6" FontFamily="Consolas, Leelawadee UI, Segoe UI"/>
                </DockPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>

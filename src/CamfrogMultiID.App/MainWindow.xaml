<Window x:Class="CamfrogMultiID.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Camfrog Multi-ID Manager" Width="1240" Height="780" MinWidth="980" MinHeight="620" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="14">
        <WrapPanel DockPanel.Dock="Top">
            <Button Content="+ Add Account" Click="Add_Click"/>
            <Button Content="Edit..." Click="Edit_Click"/>
            <Button Content="Delete" Click="Delete_Click"/>
            <Button Content="Enable/Disable" Click="ToggleEnabled_Click"/>
            <Button Content="Settings" Click="Settings_Click"/>
            <Button Content="Start Selected" Click="StartSelected_Click"/>
            <Button Content="Stop Selected" Click="StopSelected_Click"/>
            <Button Content="Start All" Click="StartAll_Click"/>
            <Button Content="Stop All" Click="StopAll_Click"/>
            <Button Content="Refresh" Click="Refresh_Click"/>
            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="SearchBox" Width="200" Height="26" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/>
            </StackPanel>
        </WrapPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock x:Name="StatusCounts" Text="—"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="StatusClient" Text="—"/></StatusBarItem>
        </StatusBar>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="200"/></Grid.RowDefinitions>
            <DataGrid x:Name="AccountsGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Margin="0,10" CanUserAddRows="False" SelectionChanged="AccountsGrid_SelectionChanged" MouseDoubleClick="AccountsGrid_DoubleClick" KeyDown="AccountsGrid_KeyDown">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Start" Click="StartSelected_Click"/>
                        <MenuItem Header="Stop" Click="StopSelected_Click"/>
                        <Separator/>
                        <MenuItem Header="Edit..." Click="Edit_Click"/>
                        <MenuItem Header="Enable/Disable" Click="ToggleEnabled_Click"/>
                        <MenuItem Header="Change Password..." Click="ChangePassword_Click"/>
                        <MenuItem Header="Clear Error" Click="ClearError_Click"/>
                        <Separator/>
                        <MenuItem Header="Delete" Click="Delete_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/>
                    <DataGridTextColumn Header="Account" Binding="{Binding DisplayName}" Width="170"/>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="150"/>
                    <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="70"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70"/>
                    <DataGridTextColumn Header="Started (UTC)" Binding="{Binding StartedAtUtc}" Width="170"/>
                    <DataGridTextColumn Header="Error" Binding="{Binding LastError}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <GroupBox Grid.Row="1" Header="Selected Account" Margin="0,0,0,8">
                <TextBlock x:Name="DetailsBox" TextWrapping="Wrap" Padding="6" FontFamily="Consolas" FontSize="12" Text="Select an account to see isolation details and launch preview."/>
            </GroupBox>
            <GroupBox Grid.Row="2" Header="Application Log">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Level:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="LogLevelBox" Width="110" SelectionChanged="LogLevelBox_SelectionChanged">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                            <ComboBoxItem Content="INFO"/>
                            <ComboBoxItem Content="WARN"/>
                            <ComboBoxItem Content="ERROR"/>
                        </ComboBox>
                        <CheckBox x:Name="AutoScrollBox" Content="Auto-scroll" IsChecked="True" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <Button Content="Clear Log View" Click="ClearLogView_Click" Margin="12,0,0,0"/>
                        <Button Content="Open Log Folder" Click="OpenLogFolder_Click" Margin="4,0,0,0"/>
                    </StackPanel>
                    <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="6" FontFamily="Consolas"/>
                </DockPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>

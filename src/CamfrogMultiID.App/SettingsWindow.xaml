<Window x:Class="CamfrogMultiID.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:CamfrogMultiID.App" Title="{x:Static loc:Strings.SettingsTitle}" Width="740" Height="830" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{x:Static loc:Strings.ClientExecutable}"/>
        <DockPanel Grid.Row="1" Margin="0,4,0,8"><Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.Browse}" Click="Browse_Click" Width="100"/><TextBox x:Name="Exe" Margin="0,0,8,0"/></DockPanel>
        <TextBlock Grid.Row="2" x:Name="ExeStatus" Foreground="Gray" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="3" Text="{x:Static loc:Strings.ArgsTemplate}"/>
        <TextBox Grid.Row="4" x:Name="Args" Margin="0,4,0,4" VerticalContentAlignment="Center" Height="30"/>
        <TextBlock Grid.Row="5" TextWrapping="Wrap" Margin="0,0,0,4" Text="{x:Static loc:Strings.ArgsHint}"/>
        <CheckBox Grid.Row="6" x:Name="SandboxBox" Content="{x:Static loc:Strings.SandboxLabel}" Margin="0,8,0,4"/>
        <TextBlock Grid.Row="7" Text="{x:Static loc:Strings.SandboxExeLabel}"/>
        <DockPanel Grid.Row="8" Margin="0,4,0,4"><Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.Browse}" Click="BrowseSandbox_Click" Width="100"/><TextBox x:Name="SandboxExe" Margin="0,0,8,0"/></DockPanel>
        <TextBlock Grid.Row="9" x:Name="SandboxStatus" Foreground="Gray" Margin="0,0,0,4" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="10" Orientation="Horizontal" Margin="0,0,0,4">
            <Button Content="{x:Static loc:Strings.DownloadSandboxie}" Click="DownloadSandboxie_Click" Width="170"/>
            <Button Content="{x:Static loc:Strings.CreateBoxes}" Click="CreateBoxes_Click" Width="210"/>
        </StackPanel>
        <StackPanel Grid.Row="11" Orientation="Horizontal" Margin="0,4,0,4" VerticalAlignment="Center">
            <TextBlock Text="{x:Static loc:Strings.AutoBackupEvery}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="BackupDays" Width="50" Height="26" VerticalContentAlignment="Center"/>
            <TextBlock Text="{x:Static loc:Strings.DaysOffHint}" VerticalAlignment="Center" Margin="6,0,6,0"/>
            <TextBox x:Name="BackupKeep" Width="50" Height="26" VerticalContentAlignment="Center"/>
            <TextBlock Text="{x:Static loc:Strings.Files}" VerticalAlignment="Center" Margin="6,0,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="12" Orientation="Horizontal" Margin="0,4,0,4" VerticalAlignment="Center">
            <TextBlock Text="{x:Static loc:Strings.Language}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="LanguageBox" Width="160" SelectionChanged="LanguageBox_SelectionChanged">
                <ComboBoxItem Content="English" Tag="en"/>
                <ComboBoxItem Content="ไทย" Tag="th"/>
            </ComboBox>
        </StackPanel>
        <CheckBox Grid.Row="13" x:Name="AutoStartBox" Content="{x:Static loc:Strings.AutoStartAccounts}" Margin="0,4,0,4"/>
        <DockPanel Grid.Row="14" Margin="0,8,0,8"><TextBlock x:Name="DataDirText" VerticalAlignment="Center" TextWrapping="Wrap"/><Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.OpenDataFolder}" Click="OpenFolder_Click" Width="130" Margin="8,0,0,0"/></DockPanel>
        <StackPanel Grid.Row="15" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="{x:Static loc:Strings.BackupData}" Click="Backup_Click" Width="130"/>
            <Button Content="{x:Static loc:Strings.RestoreData}" Click="Restore_Click" Width="130"/>
        </StackPanel>
        <StackPanel Grid.Row="16" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{x:Static loc:Strings.Cancel}" Click="Cancel_Click" IsCancel="True"/><Button Content="{x:Static loc:Strings.Save}" Click="Save_Click" IsDefault="True"/></StackPanel>
    </Grid>
</Window>

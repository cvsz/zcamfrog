<Window x:Class="CamfrogMultiID.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Settings" Width="740" Height="700" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Camfrog client executable"/>
        <DockPanel Grid.Row="1" Margin="0,4,0,8"><Button DockPanel.Dock="Right" Content="Browse..." Click="Browse_Click" Width="100"/><TextBox x:Name="Exe" Margin="0,0,8,0"/></DockPanel>
        <TextBlock Grid.Row="2" x:Name="ExeStatus" Foreground="Gray" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="3" Text="Client arguments template (optional)"/>
        <TextBox Grid.Row="4" x:Name="Args" Margin="0,4,0,4" VerticalContentAlignment="Center" Height="30"/>
        <TextBlock Grid.Row="5" TextWrapping="Wrap" Margin="0,0,0,4" Text="Supported placeholders: {username}, {profile}. Leave blank unless your installed client documents these options. Password is never injected."/>
        <CheckBox Grid.Row="6" x:Name="SandboxBox" Content="Run each account in its own Sandboxie box (allows simultaneous instances)" Margin="0,8,0,4"/>
        <TextBlock Grid.Row="7" Text="Sandboxie Start.exe (blank = auto-detect)"/>
        <DockPanel Grid.Row="8" Margin="0,4,0,4"><Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseSandbox_Click" Width="100"/><TextBox x:Name="SandboxExe" Margin="0,0,8,0"/></DockPanel>
        <TextBlock Grid.Row="9" x:Name="SandboxStatus" Foreground="Gray" Margin="0,0,0,4" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="10" Orientation="Horizontal" Margin="0,0,0,4">
            <Button Content="Download Sandboxie-Plus" Click="DownloadSandboxie_Click" Width="170"/>
            <Button Content="Create Boxes For All Accounts" Click="CreateBoxes_Click" Width="210"/>
        </StackPanel>
        <DockPanel Grid.Row="11" Margin="0,8,0,8"><TextBlock x:Name="DataDirText" VerticalAlignment="Center" TextWrapping="Wrap"/><Button DockPanel.Dock="Right" Content="Open Data Folder" Click="OpenFolder_Click" Width="130" Margin="8,0,0,0"/></DockPanel>
        <StackPanel Grid.Row="12" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Backup Data..." Click="Backup_Click" Width="130"/>
            <Button Content="Restore Data..." Click="Restore_Click" Width="130"/>
        </StackPanel>
        <StackPanel Grid.Row="13" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="Cancel_Click" IsCancel="True"/><Button Content="Save" Click="Save_Click" IsDefault="True"/></StackPanel>
    </Grid>
</Window>

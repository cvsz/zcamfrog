<Window x:Class="CamfrogMultiID.App.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Camfrog Account" Width="460" Height="330"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Display name" Margin="0,0,0,5"/>
        <TextBox Grid.Row="1" x:Name="DisplayNameTextBox" Height="30" Margin="0,0,0,12"/>
        <TextBlock Grid.Row="2" Text="Username" Margin="0,0,0,5"/>
        <TextBox Grid.Row="3" x:Name="UsernameTextBox" Height="30" Margin="0,0,0,12"/>
        <StackPanel Grid.Row="4">
            <TextBlock Text="Password" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordInput" Height="30" Margin="0,0,0,10"/>
            <CheckBox x:Name="EnabledCheckBox" Content="Enabled" IsChecked="True"/>
        </StackPanel>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click" IsCancel="True"/>
            <Button Content="Save" Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>

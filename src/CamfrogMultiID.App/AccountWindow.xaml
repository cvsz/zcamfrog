<Window x:Class="CamfrogMultiID.App.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CamfrogMultiID.App"
        Title="{x:Static loc:Strings.AddAccountTitle}" Width="480" Height="570"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{x:Static loc:Strings.DisplayName}" Margin="0,0,0,5"/>
        <TextBox Grid.Row="1" x:Name="DisplayNameTextBox" Height="30" Margin="0,0,0,12" MaxLength="80"/>
        <TextBlock Grid.Row="2" Text="{x:Static loc:Strings.Username}" Margin="0,0,0,5"/>
        <TextBox Grid.Row="3" x:Name="UsernameTextBox" Height="30" Margin="0,0,0,12" MaxLength="80"/>
        <StackPanel Grid.Row="4">
            <TextBlock x:Name="PasswordLabel" Text="{x:Static loc:Strings.Password}" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordInput" Height="30" Margin="0,0,0,4"/>
            <TextBlock x:Name="PasswordHint" Text="{x:Static loc:Strings.PasswordHintAdd}" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBlock Text="{x:Static loc:Strings.RoomUrlLabel}" Margin="0,0,0,5"/>
            <TextBox x:Name="RoomUrlTextBox" Height="30" Margin="0,0,0,4" MaxLength="500"/>
            <TextBlock Text="{x:Static loc:Strings.RoomUrlHint}" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <CheckBox x:Name="EnabledCheckBox" Content="{x:Static loc:Strings.Enabled}" IsChecked="True"/>
            <CheckBox x:Name="AutoRestartCheckBox" Content="{x:Static loc:Strings.AutoRestartLabel}" Margin="0,4,0,0"/>
        </StackPanel>
        <TextBlock Grid.Row="6" x:Name="EditHint" Text="" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static loc:Strings.Cancel}" Click="Cancel_Click" IsCancel="True"/>
            <Button Content="{x:Static loc:Strings.Save}" Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="CamfrogMultiID.App.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Password" Width="440" Height="240"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="AccountLabel" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" Text="New password" Margin="0,0,0,5"/>
        <PasswordBox Grid.Row="2" x:Name="NewPasswordBox" Height="30" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="3" Text="Replaces the DPAPI-protected secret. The old password cannot be recovered." Foreground="Gray" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click" IsCancel="True"/>
            <Button Content="Save" Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>

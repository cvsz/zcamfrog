<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>CamfrogMultiID</AssemblyName>
    <RootNamespace>CamfrogMultiID.App</RootNamespace>
    <Version>1.3.0</Version>
    <Company>cvsz</Company>
    <Product>Camfrog Multi-ID Manager</Product>
    <Copyright>Copyright (c) 2026 cvsz</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CamfrogMultiID.Core\CamfrogMultiID.Core.csproj" />
    <ProjectReference Include="..\CamfrogMultiID.Infrastructure\CamfrogMultiID.Infrastructure.csproj" />
  </ItemGroup>
</Project>
